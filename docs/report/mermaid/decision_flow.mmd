%% decision_flow.mmd - mermaid source of a figure in the project report
flowchart TB
    S["Item with fused probabilities,<br/>uncertainty U, family set C and contamination index"]
    Q1{"Hazardous family<br/>in the set C?"}
    Q2{"C is only hazardous<br/>and U below threshold?"}
    HB["Hazardous bin"]
    PR["Priority manual review<br/>(kept out of every recycling bin)"]
    Q3{"Exactly one family in C<br/>and U below threshold?"}
    MR["Manual review"]
    Q4{"Contamination index above<br/>its threshold on a recyclable?"}
    CR["Contamination reject"]
    FB["Bin of the single family"]
    S --> Q1
    Q1 -- yes --> Q2
    Q2 -- yes --> HB
    Q2 -- no --> PR
    Q1 -- no --> Q3
    Q3 -- no --> MR
    Q3 -- yes --> Q4
    Q4 -- yes --> CR
    Q4 -- no --> FB
    style HB fill:#f8cecc,stroke:#b85450
    style PR fill:#ffe6cc,stroke:#d79b00
    style MR fill:#dae8fc,stroke:#6c8ebf
    style CR fill:#e1d5e7,stroke:#9673a6
    style FB fill:#d5e8d4,stroke:#82b366
